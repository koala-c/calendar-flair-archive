rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /flairs/{flairId} {
      allow read: if true;
      allow delete: if false;
      allow create, update: if flairId.matches('^[a-z][a-z0-9_-]{0,63}$')
        && request.resource.data.id == flairId
        && request.resource.data.keys().hasOnly(['id', 'keywordsByLocale', 'updatedAt'])
        && (
          !('keywordsByLocale' in request.resource.data)
          || (
            request.resource.data.keywordsByLocale is map
            && request.resource.data.keywordsByLocale.size() <= 80
          )
        );
    }
  }
}
